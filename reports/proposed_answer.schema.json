{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hisedu.local/schemas/answer.schema.json",
  "title": "HISEDU history question-answer record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_name",
    "version",
    "id",
    "chunk_id",
    "title",
    "question",
    "answer",
    "answer_type",
    "difficulty",
    "chapter",
    "lesson",
    "keywords",
    "source",
    "review_status",
    "provenance_note",
    "paired_question_file"
  ],
  "properties": {
    "dataset_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "chunk_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "title": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "answer_type": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "minLength": 1
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "folder",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "folder": {
          "type": "string",
          "pattern": "^chapter_\\d{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "folder",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "folder": {
          "type": "string",
          "pattern": "^(?:lesson_\\d{2}|review_lessons_\\d{2}_\\d{2})$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "locator",
        "page_number"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "page_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "review_status": {
      "type": "string",
      "minLength": 1
    },
    "provenance_note": {
      "type": "string",
      "minLength": 1
    },
    "paired_question_file": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.txt$"
    }
  }
}
