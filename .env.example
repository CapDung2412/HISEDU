# Pinecone (required for ingest/query; never commit a real key)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=hisedu-clip-v1
PINECONE_NAMESPACE=history8-v1-0-0
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# OpenAI (backend only; never expose either value through NEXT_PUBLIC_*)
CHATGPT_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Keep web search off during local development to conserve quota.
# Enable it to allow at most one verified web-search tool call per generated lesson.
HISEDU_ENABLE_WEB_SEARCH=false
HISEDU_OPENAI_TIMEOUT_SECONDS=45
HISEDU_PROMPT_VERSION=hisedu-web-v1

# Process-local cache, quiz lifetime and per-IP rate limit
HISEDU_CACHE_TTL_SECONDS=900
HISEDU_QUIZ_TTL_SECONDS=1800
HISEDU_RATE_LIMIT_REQUESTS=20
HISEDU_RATE_LIMIT_WINDOW_SECONDS=60

# Exact frontend origins, comma-separated; do not use * in production.
HISEDU_CORS_ORIGINS=http://localhost:3000

# Uploaded image limits: 5 MiB and 20 megapixels
HISEDU_MAX_IMAGE_BYTES=5242880
HISEDU_MAX_IMAGE_PIXELS=20000000

# Aligned multilingual text/image CLIP encoders (512 dimensions by default)
HISEDU_PROJECT_ROOT=
HISEDU_TEXT_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1
HISEDU_IMAGE_MODEL=sentence-transformers/clip-ViT-B-32
HISEDU_DEVICE=
HISEDU_EMBED_BATCH_SIZE=32
HISEDU_UPSERT_BATCH_SIZE=50

# Leave empty until calibrated on real phone-photo ground truth.
HISEDU_MIN_SCORE=

# Optional PaddleOCR branch
HISEDU_OCR_LANGUAGE=vi
HISEDU_OCR_MIN_LINE_SCORE=0.50
